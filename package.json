    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^8.0.0",
    "redis": "^4.6.11",
    "axios": "^1.6.2",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "express-async-errors": "^3.1.1",
    "multer": "^1.4.5-lts.1",
